name = "your_bot_username"
main = "src/index.ts"
compatibility_date = "2024-11-18"
compatibility_flags = ["nodejs_compat"]

[vars]
# Bot username without @ (e.g., "your_bot")
BOT_USERNAME = "your_bot_username"
# Secret for Telegram webhook verification (generate a random string)
WEBHOOK_SECRET = "your_random_webhook_secret_here"
# Optional: Secret for admin endpoints (/setup-webhook, /webhook-info)
# If set, access these endpoints with ?secret=your_admin_secret
ADMIN_SECRET = "your_admin_secret_here"

# Create KV namespace with: npx wrangler kv:namespace create BUNDLES
# Then update the id and preview_id below
[[kv_namespaces]]
binding = "BUNDLES"
id = "your_kv_id_goes_here"
preview_id = "your_kv_preview_id_goes_here"

# Custom domain (optional)
# 域名必须已经在 Cloudflare 托管
routes = [{ pattern = "your.domain.com", custom_domain = true }]

# Site configuration for static assets (Vue frontend)
# __STATIC_CONTENT KV namespace is auto-managed by wrangler
[site]
bucket = "./view/main/dist"
